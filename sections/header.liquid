<header class="bg-[#1F3D7C] sticky top-0 z-[100]">

  <!-- Main row: nav/hamburger | logo | icons -->
  <div class="h-20 flex items-center justify-between px-8 md:px-4">

    <!-- Left: Desktop nav links (hidden on mobile) -->
    <nav class="hidden md:flex items-center gap-8 flex-1 text-white" aria-label="Main navigation">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="text-white no-underline text-[11px] font-extrabold uppercase tracking-[0.12em] hover:opacity-65 transition-opacity">
          {{- link.title -}}
        </a>
      {%- endfor -%}
    </nav>

    <!-- Left: Hamburger button (mobile only) -->
    <div class="flex flex-1 md:hidden">
      <button
        id="hamburger-btn"
        onclick="toggleMenu()"
        class="flex flex-col gap-1.5 cursor-pointer bg-transparent border-0 p-1"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <span id="bar1" class="block w-6 h-0.5 bg-white transition-transform duration-300"></span>
        <span id="bar2" class="block w-6 h-0.5 bg-white transition-opacity duration-300"></span>
        <span id="bar3" class="block w-6 h-0.5 bg-white transition-transform duration-300"></span>
      </button>
    </div>

    <!-- Center: Logo -->
    <div class="flex-1 flex justify-center">
      <a href="{{ routes.root_url }}" class="no-underline text-white" aria-label="{{ shop.name }}">
        {%- if section.settings.logo -%}
          {{ section.settings.logo | image_url: width: 140 | image_tag: loading: 'eager', class: 'max-h-11 w-auto block' }}
        {%- else -%}
          <span class="flex flex-col items-center leading-none gap-0.5">
            <span class="text-xl font-black tracking-[0.18em] uppercase">
              IND<span class="inline-block border-2 border-white rounded-full w-[1.05em] h-[1.05em] leading-[0.85] text-center mx-px align-middle">I</span>GO
            </span>
            <span class="text-[9px] font-bold tracking-[0.5em] uppercase">STORE</span>
          </span>
        {%- endif -%}
      </a>
    </div>

    <!-- Right: Icons -->
    <div class="flex items-center gap-5 flex-1 justify-end">
      <!-- Search: button on desktop (opens popup), hidden on mobile since the row below is always visible -->
      <button
        id="search-btn"
        onclick="toggleSearch()"
        class="hidden md:flex text-white items-center justify-center hover:opacity-65 transition-opacity bg-transparent border-0 p-0 cursor-pointer"
        aria-label="{{ 'general.search.title' | t }}"
        aria-expanded="false"
        aria-controls="desktop-search"
      >
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account menu="{{ section.settings.customer_account_menu }}" class="flex items-center justify-center text-white hover:opacity-65 transition-opacity cursor-pointer">
          {{ 'icon-account.svg' | inline_asset_content }}
        </shopify-account>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="relative text-white no-underline flex items-center justify-center hover:opacity-65 transition-opacity" aria-label="Cart ({{ cart.item_count }} items)">
        {%- if cart.item_count > 0 -%}
          <span class="absolute -top-1.5 -right-1.5 bg-white text-[#1F3D7C] text-[9px] font-extrabold rounded-full min-w-[1rem] h-4 flex items-center justify-center px-0.5 leading-none" aria-hidden="true">
            {{- cart.item_count -}}
          </span>
        {%- endif -%}
        <div class="cart-icon text-6xl leading-none">
          {{ 'icon-cart.svg' | inline_asset_content | strip }}
        </div>
      </a>
    </div>

  </div>

  <!-- Mobile search row (always visible on mobile, hidden on desktop) -->
  <div class="md:hidden px-4 pb-3">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <div class="relative flex items-center">
        <svg class="absolute left-3 w-4 h-4 text-white/60 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input
          type="search"
          name="q"
          placeholder="{{ 'general.search.placeholder' | t }}"
          class="mobile-search-input w-full bg-white/10 text-white placeholder-white/50 border border-white/25 rounded-full pl-9 pr-4 py-2 text-sm outline-none"
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
      </div>
    </form>
  </div>

  <!-- Mobile menu dropdown (full width, below header) -->
  <div
    id="mobile-menu"
    class="hidden absolute top-full left-0 w-full bg-[#1F3D7C] border-t border-white/20 md:hidden"
    aria-label="Mobile navigation"
  >
    {%- for link in section.settings.menu.links -%}
      <a
        href="{{ link.url }}"
        class="block px-8 py-4 text-white no-underline text-[11px] font-extrabold uppercase tracking-[0.12em] hover:bg-white/10 transition-colors border-b border-white/10 last:border-b-0"
      >
        {{- link.title -}}
      </a>
    {%- endfor -%}
  </div>

  <!-- Desktop search popup (hidden until search button is clicked) -->
  <div
    id="desktop-search"
    class="hidden absolute top-full left-0 w-full bg-[#1F3D7C] border-t border-white/20 p-4 shadow-lg"
    role="search"
    aria-label="{{ 'general.search.title' | t }}"
  >
    <form action="{{ routes.search_url }}" method="get">
      <div class="flex items-center gap-3 max-w-2xl mx-auto">
        <div class="relative flex-1">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-white/60 pointer-events-none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            id="desktop-search-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t }}"
            class="desktop-search-input w-full bg-white/10 text-white placeholder-white/50 border border-white/25 rounded-full pl-11 pr-4 py-2.5 text-sm outline-none"
            aria-label="{{ 'general.search.placeholder' | t }}"
          >
        </div>
        <button
          type="button"
          onclick="closeSearch()"
          class="text-white/70 hover:text-white transition-colors bg-transparent border-0 cursor-pointer p-1 flex-shrink-0"
          aria-label="Close search"
        >
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </form>
  </div>

</header>

<script>
  function toggleMenu() {
    var menu = document.getElementById('mobile-menu');
    var btn = document.getElementById('hamburger-btn');
    var bar1 = document.getElementById('bar1');
    var bar2 = document.getElementById('bar2');
    var bar3 = document.getElementById('bar3');
    var isOpen = !menu.classList.contains('hidden');

    if (isOpen) {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      bar1.style.transform = '';
      bar2.style.opacity = '';
      bar3.style.transform = '';
    } else {
      menu.classList.remove('hidden');
      btn.setAttribute('aria-expanded', 'true');
      bar1.style.transform = 'translateY(8px) rotate(45deg)';
      bar2.style.opacity = '0';
      bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
    }
  }

  function toggleSearch() {
    var popup = document.getElementById('desktop-search');
    var isOpen = !popup.classList.contains('hidden');
    if (isOpen) {
      closeSearch();
    } else {
      popup.classList.remove('hidden');
      document.getElementById('search-btn').setAttribute('aria-expanded', 'true');
      document.getElementById('desktop-search-input').focus();
    }
  }

  function closeSearch() {
    var popup = document.getElementById('desktop-search');
    popup.classList.add('hidden');
    document.getElementById('search-btn').setAttribute('aria-expanded', 'false');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSearch();
  });

  document.addEventListener('click', function(e) {
    var popup = document.getElementById('desktop-search');
    var btn = document.getElementById('search-btn');
    if (popup && !popup.classList.contains('hidden') && !popup.contains(e.target) && btn && !btn.contains(e.target)) {
      closeSearch();
    }
  });
</script>

{% stylesheet %}
  .site-header shopify-account svg,
  .site-header svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  shopify-account svg {
    color: #fff;
    fill: none;
    stroke: currentColor;
  }
  .mobile-search-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.15);
  }
  .desktop-search-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
    background-color: rgba(255, 255, 255, 0.15);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}
