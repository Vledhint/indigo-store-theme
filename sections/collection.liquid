{%- render 'ticker', text: collection.title, theme: 'dark' -%}

<div id="filters-btn" class="flex items-center gap-2 px-8 py-4 border-b border-gray-200 text-xs font-bold uppercase tracking-[0.08em] cursor-pointer sm:px-4">
  <span>{{ 'collections.filters' | t }}</span>
  <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
</div>

<!-- Filters Overlay -->
<div id="filters-overlay" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="{{ 'collections.filters' | t }}">
  <div id="filters-backdrop" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-300"></div>

  <div id="filters-panel" class="absolute left-0 top-0 h-full w-80 bg-white flex flex-col -translate-x-1/3 transition-transform duration-300 sm:w-1/3">
    <div class="flex items-center justify-between px-6 py-5 border-b border-gray-200 shrink-0">
      <span class="text-xs font-bold uppercase tracking-[0.08em]">{{ 'collections.filters' | t }}</span>
      <button id="filters-close" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-black transition-colors cursor-pointer bg-transparent border-0 font-[inherit]" aria-label="Close filters">
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <form id="filters-form" action="{{ request.path }}" method="get" class="flex flex-col flex-1 overflow-hidden">
      {%- if collection.sort_by != blank -%}
        <input type="hidden" name="sort_by" value="{{ collection.sort_by }}">
      {%- endif -%}

      <div class="flex-1 overflow-y-auto">
        {%- for filter in collection.filters -%}
          {%- assign filter_id = 'filter-group-' | append: forloop.index -%}
          {%- assign is_color = false -%}
          {%- assign label_lower = filter.label | downcase -%}
          {%- if label_lower contains 'color' or label_lower contains 'colour' -%}
            {%- assign is_color = true -%}
          {%- endif -%}

          <div class="border-b border-gray-100">
            <button type="button" class="filter-group-toggle w-full flex items-center justify-between px-6 py-4 text-xs font-bold uppercase tracking-[0.08em] cursor-pointer bg-transparent border-0 font-[inherit] text-left" aria-expanded="true" data-target="{{ filter_id }}">
              <span>{{ filter.label }}</span>
              <svg class="w-3.5 h-3.5 transition-transform duration-200 filter-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
            </button>

            <div id="{{ filter_id }}" class="filter-options px-6 pb-5">
              {%- if filter.type == 'list' -%}
                {%- if is_color -%}
                  <div class="flex flex-wrap gap-2.5">
                    {%- for value in filter.values -%}
                      <label class="color-swatch-label cursor-pointer" title="{{ value.label | escape }} ({{ value.count }})">
                        <input type="checkbox" name="{{ filter.param_name }}" value="{{ value.value }}" class="sr-only" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span class="block w-7 h-7 rounded-full border-2 transition-all duration-150 {% if value.active %}border-[#1F3D7C] scale-110{% else %}border-transparent{% endif %} {% if value.count == 0 and value.active == false %}opacity-30 cursor-not-allowed{% endif %}" style="background:{{ value.label | downcase | replace: ' ', '' }};box-shadow:0 0 0 1.5px rgba(0,0,0,0.15);"></span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="flex flex-col gap-2.5">
                    {%- for value in filter.values -%}
                      <label class="flex items-center gap-2.5 cursor-pointer group {% if value.count == 0 and value.active == false %}opacity-40 pointer-events-none{% endif %}">
                        <input type="checkbox" name="{{ filter.param_name }}" value="{{ value.value }}" class="w-3.5 h-3.5 shrink-0 accent-[#1F3D7C]" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span class="text-xs uppercase tracking-wide group-hover:text-[#1F3D7C] transition-colors leading-none">{{ value.label }} <span class="text-gray-400 normal-case font-normal">({{ value.count }})</span></span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              {%- elsif filter.type == 'price_range' -%}
                <div class="flex items-end gap-2">
                  <div class="flex-1">
                    <label class="block text-[10px] uppercase tracking-widest text-gray-400 mb-1.5">Min</label>
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | divided_by: 100.0 | default: '' }}" placeholder="{{ filter.range_min | money_without_currency }}" min="{{ filter.range_min | divided_by: 100.0 }}" max="{{ filter.range_max | divided_by: 100.0 }}" class="w-full border border-gray-200 px-2.5 py-2 text-xs font-[inherit] focus:outline-none focus:border-[#1F3D7C] transition-colors">
                  </div>
                  <span class="text-gray-300 pb-2.5">—</span>
                  <div class="flex-1">
                    <label class="block text-[10px] uppercase tracking-widest text-gray-400 mb-1.5">Max</label>
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | divided_by: 100.0 | default: '' }}" placeholder="{{ filter.range_max | money_without_currency }}" min="{{ filter.range_min | divided_by: 100.0 }}" max="{{ filter.range_max | divided_by: 100.0 }}" class="w-full border border-gray-200 px-2.5 py-2 text-xs font-[inherit] focus:outline-none focus:border-[#1F3D7C] transition-colors">
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- else -%}
          <p class="px-6 py-10 text-xs text-gray-400 uppercase tracking-wide">{{ 'collections.no_filters' | t | default: 'No filters available' }}</p>
        {%- endfor -%}
      </div>

      {%- if collection.filters.size > 0 -%}
        <div class="px-6 py-5 border-t border-gray-200 flex gap-3 shrink-0">
          <button type="submit" class="flex-1 py-2.5 text-xs font-bold uppercase tracking-[0.08em] bg-[#1F3D7C] text-white cursor-pointer border-0 font-[inherit] hover:bg-[#163066] transition-colors">
            {{ 'collections.apply_filters' | t | default: 'Apply' }}
          </button>
          <a href="{{ collection.url }}" class="flex-1 py-2.5 text-xs font-bold uppercase tracking-[0.08em] border border-gray-200 text-gray-600 no-underline flex items-center justify-center hover:border-gray-400 transition-colors">
            {{ 'collections.clear_all' | t | default: 'Clear all' }}
          </a>
        </div>
      {%- endif -%}
    </form>
  </div>
</div>

<div class="px-8 pt-6 pb-12 max-w-[1300px] mx-auto sm:px-4">
  {%- paginate collection.products by 12 -%}
    <div class="grid grid-cols-4 lg:grid-cols-3 md:grid-cols-2 gap-5 sm:gap-3">
      {%- for product in collection.products -%}
        {%- render 'category-product-card', product: product -%}
      {%- else -%}
        <p class="col-span-4 text-center py-12 text-sm text-gray-500">{{ 'collections.empty' | t }}</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="collection-pagination flex justify-center gap-2 mt-12 pt-8 border-t ">
        {{ paginate | default_pagination }}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% stylesheet %}
  .collection-pagination span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid #1F3D7C;
    color: #1F3D7C;
    transition: background 0.15s, color 0.15s;
  }
  .collection-pagination .current,
  .collection-pagination span:hover {
    background: #1F3D7C;
    color: #fff;
  }
  .color-swatch-label input:focus-visible + span {
    outline: 2px solid #1F3D7C;
    outline-offset: 2px;
  }
  .color-swatch-label:has(input:not(:disabled)):hover span {
    border-color: #9ca3af;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var btn = document.getElementById('filters-btn');
    var overlay = document.getElementById('filters-overlay');
    var backdrop = document.getElementById('filters-backdrop');
    var panel = document.getElementById('filters-panel');
    var closeBtn = document.getElementById('filters-close');

    function openFilters() {
      overlay.classList.remove('hidden');
      overlay.offsetHeight; // force reflow
      backdrop.classList.replace('opacity-0', 'opacity-100');
      panel.classList.remove('-translate-x-1/3');
      document.body.style.overflow = 'hidden';
    }

    function closeFilters() {
      backdrop.classList.replace('opacity-100', 'opacity-0');
      panel.classList.add('-translate-x-1/3');
      document.body.style.overflow = '';
      setTimeout(function () { overlay.classList.add('hidden'); }, 300);
    }

    if (btn) btn.addEventListener('click', openFilters);
    if (backdrop) backdrop.addEventListener('click', closeFilters);
    if (closeBtn) closeBtn.addEventListener('click', closeFilters);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) closeFilters();
    });

    // Accordion toggles
    document.querySelectorAll('.filter-group-toggle').forEach(function (toggle) {
      toggle.addEventListener('click', function () {
        var targetId = toggle.dataset.target;
        var target = document.getElementById(targetId);
        var chevron = toggle.querySelector('.filter-chevron');
        var isOpen = toggle.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          target.style.display = 'none';
          toggle.setAttribute('aria-expanded', 'false');
          chevron.classList.add('rotate-180');
        } else {
          target.style.display = '';
          toggle.setAttribute('aria-expanded', 'true');
          chevron.classList.remove('rotate-180');
        }
      });
    });

    // Color swatch visual update on toggle
    document.querySelectorAll('.color-swatch-label input').forEach(function (input) {
      input.addEventListener('change', function () {
        var swatch = input.nextElementSibling;
        if (input.checked) {
          swatch.classList.add('border-[#1F3D7C]', 'scale-110');
          swatch.classList.remove('border-transparent');
        } else {
          swatch.classList.remove('border-[#1F3D7C]', 'scale-110');
          swatch.classList.add('border-transparent');
        }
      });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
