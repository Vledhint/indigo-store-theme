<div
  id="size-guide-backdrop"
  class="fixed inset-0 bg-black/50 z-40 hidden"
  onclick="closeSizeGuide()"
  aria-hidden="true"
></div>

<div
  id="size-guide-modal"
  class="fixed inset-0 z-50 flex items-center justify-center hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="size-guide-title"
>
  <div class="bg-white shadow-xl w-full max-w-2xl mx-4 max-h-[80vh] flex flex-col">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 shrink-0">
      <h2 id="size-guide-title" class="text-[11px] font-extrabold uppercase tracking-[0.15em] m-0">
        {{- 'products.size_guide' | t -}}
      </h2>
      <button
        onclick="closeSizeGuide()"
        class="text-gray-400 hover:text-gray-800 transition-colors leading-none text-lg font-light"
        aria-label="Cerrar"
      >&#x2715;</button>
    </div>
    <div class="overflow-y-auto px-6 py-5 text-sm text-gray-700 leading-relaxed size-guide-content">
      {{ content }}
    </div>
  </div>
</div>

<script>
  function openSizeGuide() {
    document.getElementById('size-guide-modal').classList.remove('hidden');
    document.getElementById('size-guide-backdrop').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeSizeGuide() {
    document.getElementById('size-guide-modal').classList.add('hidden');
    document.getElementById('size-guide-backdrop').classList.add('hidden');
    document.body.style.overflow = '';
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeSizeGuide();
  });
</script>

{% stylesheet %}
  .size-guide-content table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .size-guide-content th {
    background: #1F3D7C;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 800;
    font-size: 10px;
    padding: 8px 12px;
    text-align: center;
    border: 1px solid #1F3D7C;
  }
  .size-guide-content td {
    padding: 7px 12px;
    text-align: center;
    border: 1px solid #e5e7eb;
  }
  .size-guide-content tr:nth-child(even) td {
    background: #f9fafb;
  }
  .size-guide-content h1, .size-guide-content h2, .size-guide-content h3 {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #1F3D7C;
    margin-bottom: 12px;
  }
{% endstylesheet %}
