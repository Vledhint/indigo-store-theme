{% doc %}
  Renders a product card with image, add-to-cart and buy buttons, title, price, and color swatches.

  @param {product} product - The product to render

  @example
  {% render 'product-card', product: product %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign color_option_index = nil
  for option in product.options
    if option == 'Color' or option == 'color' or option == 'Colour' or option == 'colour' or option == 'COLOR'
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

<div class="flex flex-col relative">
  <a href="{{ product.url }}" class="group block overflow-hidden aspect-[4/5] bg-white" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600, height: 600, crop: 'center' | image_tag: loading: 'lazy', width: 600, height: 600, class: 'w-[600px] h-[600px] object-cover transition-transform duration-500 group-hover:scale-[1.04]' }}
    {%- else -%}
      {{ 'product' | placeholder_svg_tag: 'w-full h-full object-cover' }}
    {%- endif -%}
  </a>

  <div class="mt-2 absolute top-auto bottom-25 left-0 right-0">
    <p class="text-[11px] font-bold uppercase tracking-[0.04em] leading-tight mb-1 text-white text-shadow-lg/50">{{ product.title | escape }}</p>
    <p class="text-xs font-semibold text-white text-shadow-lg/50">{{ product.price | money }}</p>
  </div>

  <div class="flex mt-2 absolute bottom-10 left-0 right-0">
    <form action="{{ routes.cart_add_url }}" method="post" class="flex flex-1">
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="flex-1 py-2 px-1 text-[16px] uppercase tracking-wide border-[1.5px] border-[#1F3D7C] border-r-0 bg-[#1F3D7C] text-white cursor-pointer transition-colors hover:bg-[#1F3D7C] hover:text-white font-[inherit] mr-3 rounded-s-full">
        {{- 'products.add_to_cart' | t -}}
      </button>
    </form>
    <a href="{{ product.url }}" class="flex-1 flex items-center justify-center py-2 px-1 text-[16px] uppercase tracking-wide border-[1.5px] border-[#1F3D7C] bg-[#1F3D7C] text-white no-underline transition-colors ml-3 rounded-r-full">
      {{- 'products.buy_now' | t -}}
    </a>
  </div>

</div>
