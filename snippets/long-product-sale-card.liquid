
{% doc %}
  Renders a product card with image, add-to-cart and buy buttons, title, price, and color swatches.

  @param {product} product - The product to render

  @example
  {% render 'rect-product-sale-card', product: product %}
{% enddoc %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="flex flex-col max-w-full mx-auto justify-center text-center relative">
  <a href="{{ product.url }}" class="group block overflow-hidden aspect-auto" aria-label="{{ product.title | escape }}">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 550, height: 850, crop: 'center' | image_tag: loading: 'lazy', width: 550, height: 850, class: 'w-[550px] h-auto object-contain transition-transform duration-500 group-hover:scale-[1.04] mx-auto' }}
    {%- else -%}
      {{ 'product' | placeholder_svg_tag: 'w-full h-full object-cover' }}
    {%- endif -%}
  </a>

  <div class="flex mt-2 absolute bottom-2 w-full mx-auto">
    <form action="{{ routes.cart_add_url }}" method="post" class="flex flex-1">
      <input type="hidden" name="id" value="{{ current_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="flex-1 py-1 px-1 text-[16px] uppercase tracking-wide bg-transparent text-white cursor-pointer transition-colors font-[inherit] mr-3 rounded-s-full">
        <img src="{{ 'agregar.svg' | asset_url }}" alt="Agregar Icon" width="50" height="50" class="absolute left-1 bottom-0">
      </button>
    </form>
    <a href="{{ product.url }}" class="flex-1 flex items-center justify-center py-2 px-1 text-[16px] uppercase tracking-wide text-white no-underline transition-colors ml-3 rounded-r-full">
        <img src="{{ 'ahora.svg' | asset_url }}" alt="Agregar Icon" width="50" height="50" class="absolute right-1 bottom-0">
    </a>
    <div class="mt-2 absolute left-0 right-0 bottom-2">
        <p class="text-[11px] font-bold uppercase tracking-[0.04em] leading-tight mb-1 text-white text-shadow-lg/50 inline">{{ product.title | escape }}</p>
        <p class="text-xs font-semibold text-white text-shadow-lg/50">{{ product.price | money }}</p>
    </div>
  </div>

</div>
